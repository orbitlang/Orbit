# PoC sym-003 — SYM-003: a nested function that uses a name declared later in
# the enclosing function (a sibling function, or a local) must reach that
# declaration.
#
# When the reference is parsed the name is not declared yet, so it becomes an
# UNKNOWN symbol of the nested scope. ComputeLocalVarOffset later resolves it
# with LookupInEnclosing and makes it an alias of the enclosing declaration,
# but never marks that declaration CLOSURE nor the scopes in between: the
# declaration stays a stack local of the enclosing function, and the nested
# function reads its own frame at that offset. A sibling declared later is
# called as nil; a local declared later reads whatever its own frame holds.
#
# The same code with the declaration first works and is the control; so does
# a forward reference at module level.
#
# A runtime test: prints "ALL TESTS PASSED" only when every check matches.
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

func declared_first() {
    func b() { return 1 }
    func a() { return b() }
    return a()
}
check("control: the sibling is declared first", declared_first(), 1)

func mod_a() { return mod_b() }
func mod_b() { return 2 }
check("control: a forward reference at module level", mod_a(), 2)

func sibling_after() {
    func a() { return b() }
    func b() { return 1 }
    return a()
}
r_sib := trap sibling_after()
check("a sibling declared after the function that calls it", r_sib.unwrap_or("ERROR"), 1)

func local_after() {
    func a() { return k }
    k := 7
    return a()
}
r_loc := trap local_after()
check("a local declared after the function that reads it", r_loc.unwrap_or("ERROR"), 7)

func two_down_after() {
    func a(x) {
        m := x
        func g() { return b(m) }
        return g()
    }
    func b(y) { return y + 1 }
    return a(1)
}
r_two := trap two_down_after()
check("a function declared later, used two levels down", r_two.unwrap_or("ERROR"), 2)

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
