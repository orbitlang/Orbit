# PoC ir-014-closure-write-after-call — IR-014: a captured variable read by
# the function that declares it, after a call that changed it, must give the
# new value.
#
# Builder::LoadFromOffset walks the current block backwards and, on finding a
# store to the same closure slot (CLOSTR), returns the stored register instead
# of loading. It does so even when a call lies between the store and the load,
# and a call is exactly how a nested function writes the slot. The function
# that declares the variable keeps seeing the value it stored itself.
#
# The other direction works and is the control: the nested function sees a
# write made by the declaring one.
#
# A runtime test: prints "ALL TESTS PASSED" only when every check matches.
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

func outer_writes() {
    n := 1
    func inner() { return n }
    n = 5
    return inner()
}
check("control: the nested function sees the declaring one's write", outer_writes(), 5)

func inner_writes() {
    n := 1
    func inner() { n = 11 }
    inner()
    return n
}
check("the declaring function sees the nested one's write", inner_writes(), 11)

func compound() {
    n := 1
    func inner() { n += 10 }
    inner()
    return n
}
check("a compound assignment in the nested function", compound(), 11)

func before_and_after() {
    n := 1
    func inner() { n = 11 }
    a := n
    inner()
    b := n
    return (a, b)
}
check("read before and after the call", before_and_after(), (1, 11))

func counter() {
    var count = 0
    func tick() { count += 1 }
    tick()
    tick()
    tick()
    return count
}
check("a counter bumped three times", counter(), 3)

# the same through a middle function that does not use the variable
func written_two_down() {
    n := 1
    func mid() {
        func inner() { n += 10 }
        inner()
    }
    mid()
    return n
}
check("a write two levels down reaches the declaring function", written_two_down(), 11)

# a suspension runs other code too: a generator that reads a captured variable
# on both sides of a `yield` must see a change made while it was suspended
func make_gen() {
    n := 1
    func gen() {
        yield n
        yield n
    }
    func set(v) { n = v }
    return (gen(), set)
}

gen_and_set := make_gen()
seen := []
for var v in gen_and_set[0] {
    seen.append(v)
    gen_and_set[1](42)
}
check("a captured variable read across a yield", seen, [1, 42])

# module variables: the module code reads them after calls too. A store
# forwarded across a call returns the value from before it, and the register a
# variable was loaded into must not be reused after a call either
var hits = 0

class Base {
    pub init() {
        hits += 1
    }
}

class Mid : Base { }

class Leaf : Mid { }

new Mid()
h1 := hits
new Leaf()
h2 := hits
check("a module variable bumped by two calls, read after each", (h1, h2), (1, 2))

func set_a() { a = 9 }

var a = 5
b := a
set_a()
check("a module variable copied before a call keeps the old value", (a, b), (9, 5))

# synchronization points: after an `await`, or a receive from a channel, the
# code must see what the other fiber wrote before it finished or sent. Only
# the value read after them is checked: the one read before depends on
# scheduling when fibers run in parallel
var m = 0

func job() async { m = 5 }

f_job := job()
m_before := m
await f_job
check("a module variable read after an await", m, 5)

var k = 0
ch := Chan(capacity=1)

func producer() {
    k = 7
    ch <- 1
}

func after_spawn() { }

spawn producer()
# a call right after the spawn keeps `ch` from being live across it (IR-016)
after_spawn()
k_before := k
<- ch
check("a module variable read after a channel receive", k, 7)

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
