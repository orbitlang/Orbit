# PoC ir-017-if-in-switch-case — IR-017: an `if` in the body of a `switch`
# case (or of its `default`) must compile. Today it aborts the compiler with
# `Assertion failed: (false), function Generate, file irbuilder.cpp`, in a
# function and at module scope.
#
# Root cause in the parser: ParseSwitchCase closes the case's scope at
# `block->loc.end`, which it never updates after reading the case's
# statements, so the scope covers only the first token after the colon. The
# `if`'s scope, a child of the case's, lies outside that range, and
# EnterNestedScope cannot find it.
#
# Controls: plain statements in a case, a `for` in a case, and an `if` after
# the switch.
#
# A runtime test: prints "ALL TESTS PASSED" only when every check matches.
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

func plain(v) {
    r := 0
    switch v {
        case 1:
            r = 1
    }
    if true { r += 10 }
    return r
}
check("control: plain statements in a case, an if after the switch", plain(1), 11)

func for_in_case(v) {
    r := 0
    switch v {
        case 1:
            for var x in [1, 2] { r += x }
    }
    return r
}
check("control: a for in a case", for_in_case(1), 3)

func if_in_case(v) {
    r := 0
    switch v {
        case 1:
            if true { r = 1 }
        default:
            if true { r = 2 }
    }
    return r
}
check("an if in a case and in the default", (if_in_case(1), if_in_case(5)), (1, 2))

# the case's scope must still be entered and left in step when its body is
# empty, or ends with `fallthrough`
func shapes(v) {
    r := []
    switch v {
        case 1:
        case 2:
            r.append(2)
            fallthrough
        case 3:
            if true { r.append(3) }
        default:
            if v == 9 { r.append(9) }
    }
    return r
}
check("an empty case, a fallthrough, nested blocks", (shapes(1), shapes(2), shapes(3), shapes(9)), ([], [2, 3], [3], [9]))

var m = 0
switch 1 {
    case 1:
        if true { m = 7 }
}
check("an if in a case at module scope", m, 7)

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
