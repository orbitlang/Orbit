# PoC ir-019-block-in-when — IR-019: an `if` in a `when` branch, followed by
# another `if` after the `when`, aborted the compiler with `Assertion failed:
# (false), function Generate, file irbuilder.cpp`: visitWhen visits the
# branches without entering their scopes, so the scope of the `if` after the
# `when` was not found.
#
# A `when` branch now holds declarations only, so the block that caused the
# abort is refused by the parser with its own message. This file must report
# that error instead of reaching the IR builder.
#
# Today the error is reported through the COMP-001 assert in file mode; the
# message is checked, not the way the process exits.
#
# EXPECT: error: Invalid statement in a 'when' branch

import "runtime"

var a = 0
when runtime.os != "" {
    if true { a = 1 }
}
if true { a += 10 }
