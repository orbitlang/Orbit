# PoC ir-023-scope-in-sync — IR-023: an `if`, a loop or a `try` inside a `sync`
# block must leave the compiler on the scope it was in.
#
# The parser gives a `sync` block its own nested scope, but visitSyncBlock never
# enters it. A nested block inside it calls EnterNestedScope from the enclosing
# scope, which goes down to the innermost scope covering its offset, through the
# `sync` one; its LeaveNestedScope goes back up a single level and stops on the
# `sync` scope. The next block entered from there (an `if` after the `sync`, the
# catch or finally of a `try` around it) is not inside that scope:
# EnterNestedScope fails, SymbolTableException aborts the compile (assert in
# IRBuilder::Generate). A closure defined in the body, whose variables live in the
# `sync` scope, aborts as well. A `sync` whose body has no nested block, and one
# that is the last block of its function, compile: they are the controls, with a
# declaration in the body that shadows an outer variable as an `if` does.
#
# A runtime test: prints "ALL TESTS PASSED" only when every check matches.
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

lock := [1]
other := [2]

func plain_body(x) {
    sync lock {
        v := x + 1
        return v
    }
}
check("control: a sync block without nested blocks", plain_body(1), 2)

func last_block(x) {
    r := 0
    sync lock {
        if x {
            r = 1
        }
    }
    return r
}
check("control: an if inside the last block", last_block(true), 1)

func if_after(x) {
    r := 0
    sync lock {
        if x {
            r += 1
        }
    }
    if x {
        r += 10
    }
    return r
}
check("an if inside a sync, then an if after it", if_after(true), 11)

func loop_after(x) {
    r := 0
    sync lock {
        if x {
            r += 1
        }
    }
    loop i := 0; i < 2; i++ {
        r += 10
    }
    return r
}
check("an if inside a sync, then a loop after it", loop_after(true), 21)

func catch_around(x) {
    r := 0
    try {
        sync lock {
            if x {
                r += 1
            }
        }
    } catch {
        r += 100
    }
    return r
}
check("an if inside a sync inside a try/catch", catch_around(true), 1)

func finally_around(x) {
    r := 0
    try {
        sync lock {
            loop i := 0; i < 2; i++ {
                r += 1
            }
        }
    } finally {
        r += 10
    }
    return r
}
check("a loop inside a sync inside a try/finally", finally_around(true), 12)

func try_inside_then_if(x) {
    r := 0
    sync lock {
        try {
            r += 1
        } catch {
        }
    }
    if x {
        r += 10
    }
    return r
}
check("a try inside a sync, then an if after it", try_inside_then_if(true), 11)

func shadows(x) {
    v := 1
    sync lock {
        v := x
    }
    return v
}
func shadows_in_if(x) {
    v := 1
    if true {
        v := x
    }
    return v
}
check("control: a declaration in the body shadows like one in an if", shadows(5), shadows_in_if(5))

func closure_inside() {
    sync lock {
        w := 10
        f := func() { return w + 1 }
        return f()
    }
}
check("a closure over a variable of the body", closure_inside(), 11)

func closure_escapes() {
    var g
    sync lock {
        w := 20
        g = func() { return w * 2 }
    }
    return g()
}
check("a closure over a variable of the body, called after it", closure_escapes(), 40)

func nested_syncs(x) {
    r := 0
    sync lock {
        if x {
            sync other {
                loop i := 0; i < 3; i++ {
                    if i == 1 {
                        r += 1
                    }
                }
            }
        }
        r += 10
    }
    if x {
        r += 100
    }
    return r
}
check("nested blocks with branches, then an if", nested_syncs(true), 111)

func gen(n) {
    sync lock {
        loop i := 0; i < n; i++ {
            if i % 2 == 0 {
                yield i
            }
        }
    }
    if n > 0 {
        yield 99
    }
}
func collect() {
    acc := []
    for var v in gen(5) {
        acc.append(v)
    }
    return tostr(acc)
}
check("a generator yielding in a branch of the body, then an if", collect(), "[0, 2, 4, 99]")

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
