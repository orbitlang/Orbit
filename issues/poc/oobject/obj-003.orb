# PoC OBJ-003 — `true` and `false` are named 'nil' wherever the runtime prints
# a type: in a Result (`ok<nil>`) and in every error message built from
# GetTypeName ("operator '+' not supported between 'nil' and 'Number'").
#
# GetTypeName files every value that is neither a heap object nor an integer
# under the BOOLEAN primitive, and no type is registered for it, so it falls
# back to the string "nil". nil takes the same road and comes out right only by
# that accident.
#
# Fixed by naming both booleans 'Bool', as the other types are named by type
# and not by value; nil keeps 'nil'. The checks pin both names down.
#
# A runtime test: prints "ALL TESTS PASSED" only when every check matches.
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

func t() { return true }
func f() { return false }
func n() { return nil }

check("ok(true) is ok<Bool>", tostr(trap t()), "ok<Bool>")
check("ok(false) is ok<Bool>", tostr(trap f()), "ok<Bool>")
check("ok(nil) is ok<nil>", tostr(trap n()), "ok<nil>")

r := trap (true + 1)
check("an operator error on true names Bool", r.unwrap_err().reason.find("'Bool'") >= 0, true)
check("and not nil", r.unwrap_err().reason.find("'nil'") >= 0, false)

r = trap false.nope
check("an attribute error on false names Bool", r.unwrap_err().reason.find("'Bool'") >= 0, true)

r = trap (nil + 1)
check("an operator error on nil still says nil", r.unwrap_err().reason.find("'nil'") >= 0, true)

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
