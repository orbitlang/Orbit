# PoC method-through-type — VM-011: a method called through its type,
# `Type.method(obj, args...)`, must run with `obj` as the receiver, exactly as
# the same method taken into a variable does (`m := Type.method; m(obj)`).
#
# The selector call emits PUSHIF, which pushes the selector's base as the
# receiver whenever the callee is a method. When the base is the type object
# itself, the type is pushed, CheckReceiver refuses it ("method call requires
# 'P' instance as receiver"), and the explicit receiver never takes its place.
# Builtin types and classes behave the same.
#
# The other half: a type object is never a valid `self` (no method of the
# metatypes `Class` and `Type` exists), but CheckReceiver checks a type
# receiver through its superclass, so a subclass passes as `self` for the
# methods of its superclass. `D.who()` returns the class `D` itself, and
# `D.get()` or `get(D)` read `self.v` out of the type object with `P`'s
# layout, without an error.
#
# Decided (2026-10-22): with no receiver left (`P.get()`) the call is a
# partial application, as `get := P.get; get()` is; the receiver is checked
# against the method's class, not the type used as selector, so
# `D.get(new P())` runs.
#
# The variable form works and is the control. A receiver of the wrong type
# must still be refused.
#
# A runtime test: prints "ALL TESTS PASSED" only when every check matches.
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

class P {
    pub var v = 5

    pub func get() { return self.v }

    pub func add(x) { return self.v + x }

    pub func who() { return self }
}

class D : P {
    pub init() {
        super.init()
    }
}

p := new P()

get := P.get
check("control: a method taken into a variable", get(p), 5)

l := [1, 2]
append := List.append
append(l, 3)
check("control: a builtin method taken into a variable", l, [1, 2, 3])

r := trap P.get(p)
check("a method called through its class", r.unwrap_or("REFUSED"), 5)

r_add := trap P.add(p, 1)
check("with an argument after the receiver", r_add.unwrap_or("REFUSED"), 6)

r_sub := trap P.get(new D())
check("with an instance of a subclass", r_sub.unwrap_or("REFUSED"), 5)

r_inh := trap D.get(new D())
check("an inherited method called through the subclass", r_inh.unwrap_or("REFUSED"), 5)

l2 := [1, 2]
r_list := trap List.append(l2, 3)
check("a builtin method called through its type", (r_list.unwrap_or("REFUSED") != "REFUSED", l2), (true, [1, 2, 3]))

r_bad := trap P.get(5)
check("a receiver of the wrong type is still refused", r_bad.unwrap_err().kind, @TypeError)

r_base := trap D.get(new P())
check("the method's class is checked, not the selector's type", r_base.unwrap_or("REFUSED"), 5)

r_partial := trap P.get()
r_partial_call := trap (r_partial.unwrap_or(nil))(p)
check("no receiver left: a partial application", r_partial_call.unwrap_or("REFUSED"), 5)

# a type object is never self
r_who := trap D.who()
check("a subclass is not self through its type", r_who.unwrap_or(nil) != D, true)

r_type_plain := trap get(D)
check("a subclass is not self without a selector", r_type_plain ? "ACCEPTED" : r_type_plain.unwrap_err().kind, @TypeError)

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
