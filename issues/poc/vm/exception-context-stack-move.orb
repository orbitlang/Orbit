# PoC exception-context-stack-move — VM-009: an exception context (the frame
# slot a `try` or a `trap` opens) must survive the VM stack growing underneath
# it.
#
# TBGIN builds the ExceptionContext inside the stack buffer and keeps its
# absolute address, in CP and in the `prev` link of the next context. Growing
# the stack is a realloc, which may move the buffer; SP and BP are offsets and
# follow it, CP and `prev` are not and keep pointing into the freed block. The
# first growth happens at 16 KB, a few hundred frames deep.
#
# A `trap` in every frame of a recursion 1,000 deep crashes (SIGSEGV in TEND,
# reading a null context). A single `try` above a deep recursion still works,
# but only because the freed block has not been reused yet: under lldb its CP
# lies 8 MB outside the live stack. Both shapes are checked, plus `try` in
# every frame.
#
# Fixed by keeping CP, and the link to the previous context, as an offset from
# the stack base biased by one (0 is "no context"). The checks after the first
# five pin down what that encoding has to keep: two contexts in one frame, each
# above a growth, and a pending action (`return`, `break`) carried across a
# growth and replaced by another one. The context at offset 0 and a panic with
# no handler at all have PoCs of their own (exception-context-module-slot.orb,
# panic-without-handler.orb).
#
# A runtime test: prints "ALL TESTS PASSED" only when every check matches.
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

kDepth := 3000

func deep(n) {
    if n == kDepth { return n }
    return deep(n + 1)
}

# one context, opened before the stack grows and closed after
r := trap deep(0)
check("one trap above a deep recursion", r.unwrap(), kDepth)

func try_above() {
    var v = 0
    try {
        v = deep(0)
    } catch e {
        v = -1
    }
    return v
}
check("one try above a deep recursion", try_above(), kDepth)

# a context in every frame: each one is linked to the one below it
func trap_each(n) {
    if n == kDepth { return n }
    inner := trap trap_each(n + 1)
    return inner.unwrap()
}
check("a trap in every frame", trap_each(0), kDepth)

func try_each(n) {
    if n == kDepth { return n }
    var v = 0
    try {
        v = try_each(n + 1)
    } catch e {
        v = -1
    }
    return v
}
check("a try in every frame", try_each(0), kDepth)

# and a panic raised at the bottom, caught and raised again by every frame
func boom_at(n) {
    if n == kDepth { panic Error(@Deep, "bottom") }
    inner := trap boom_at(n + 1)
    if !inner { panic inner.unwrap_err() }
    return inner.unwrap()
}
r_boom := trap boom_at(0)
check("a panic passed up through every trap", r_boom.unwrap_err().kind, @Deep)

# two contexts in one frame, the stack growing under both: the inner one is
# released first, and CP must then point back at the outer one
func nested_same_frame() {
    var r = 0
    try {
        try {
            r += deep(0)
        } catch {
            r = -100
        }
        r += deep(0)
        boom_at(kDepth)
    } catch e {
        r += e.kind == @Deep ? 1 : -1000
    }
    return r
}
check("two contexts in one frame, caught by the outer", nested_same_frame(), 2 * kDepth + 1)

# a return pending in a finally, the stack growing before the finally runs
func return_across_growth() {
    try {
        return deep(0)
    } finally {
        deep(0)
    }
    return -1
}
check("a return carried across a growth", return_across_growth(), kDepth)

# a pending return replaced by a break raised after the stack grew: the action
# bits have to be overwritten, not merged (RETURN | BREAK reads as RETURN)
func break_replaces_return() {
    loop {
        try {
            return "returned"
        } finally {
            try {
                deep(0)
                break
            } finally {
            }
        }
    }
    return "broke"
}
check("a break replaces a pending return across a growth", break_replaces_return(), "broke")

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
