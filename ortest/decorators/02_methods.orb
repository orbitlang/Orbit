# Decorators on methods: `@[deco] func m() {}` inside a class binds the member
# `m` to what `deco` returns, as for a plain function (01_functions.orb).
#
# The contract this suite asserts for a wrapper is the one a method needs to be
# usable: called through an instance, the wrapper receives the receiver as its
# first argument, followed by the call's own arguments, and it can call the
# decorated method with that receiver. The decorated method keeps belonging to
# its class: `self.prop` and private members work inside it.
#
# What a decorator returns for a method is installed as follows: a plain
# function becomes a method of the class through a copy (the function itself,
# possibly used elsewhere, is never changed); the method itself, a method of a
# superclass, or a method whose `self` is already bound stays as it is; a
# value that is not a function, and a native function, stay as they are; a
# method of an unrelated class is refused when the class is built.
#
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

func mark(f) { return f }

func plus_one(f) {
    func w(me) { return f(me) + 1 }
    return w
}

func scaled(f, k) {
    func w(me, x) { return f(me, x) * k }
    return w
}

func forward(f) {
    func w(...args) { return f(args...) }
    return w
}

class Counter {
    pub var v
    var hidden = 100

    pub init(v) {
        self.v = v
    }

    # a decorator that returns the method itself
    @[mark]
    pub func same() { return self.v }

    @[mark]
    func secret() { return self.hidden }

    pub func reveal() { return self.secret() }

    # wrappers
    @[plus_one]
    pub func get() { return self.v }

    @[scaled(10)]
    pub func add(x) { return self.v + x }

    @[forward]
    pub func sum(a, b) { return self.v + a + b }

    @[plus_one]
    func peek() { return self.hidden }

    pub func call_peek() { return self.peek() }
}

c := new Counter(5)

# --- the method itself ------------------------------------------------------

check("an identity decorator on a method", c.same(), 5)
check("an identity decorator on a private method", c.reveal(), 100)

# --- wrappers, called through an instance -----------------------------------

check("a wrapper on a method, called on an instance", c.get(), 6)
check("a wrapper with a decorator argument and a call argument", c.add(1), 60)
check("a forwarding wrapper", c.sum(1, 2), 8)
check("a wrapper on a private method, called from inside", c.call_peek(), 101)

# --- wrappers, called with an explicit receiver -----------------------------

get := Counter.get
check("a wrapper taken from the class, called with a receiver", get(c), 6)

# --- inheritance --------------------------------------------------------------

class Derived : Counter {
    pub init(v) {
        super.init(v)
    }
}

d := new Derived(7)
check("an inherited identity-decorated method", d.same(), 7)
check("an inherited wrapper", d.get(), 8)

# --- what the decorator returns ----------------------------------------------

# a plain function used elsewhere too: the method is a copy of it, and the
# function itself is not turned into a method
func helper(me) { return "helper" }

class FnHolder {
    pub var f = nil

    pub init(f) {
        self.f = f
    }
}

fn_holder := new FnHolder(helper)

func give_helper(f) { return helper }

class UsesHelper {
    pub init() { }

    @[give_helper]
    pub func m() { }
}

check("a shared function installed as a method", new UsesHelper().m(), "helper")
check("the shared function is left unchanged", fn_holder.f("x"), "helper")

# the method itself: it keeps checking its receiver
class Getter {
    pub var v = 4

    pub init() { }

    @[mark]
    pub func get() { return self.v }
}

class GetHolder {
    pub var g = nil

    pub init(g) {
        self.g = g
    }
}

r_recv := trap new GetHolder(Getter.get).g()
check("an identity-decorated method still checks its receiver", r_recv.unwrap_err().kind, @TypeError)

# a value that is not a function is installed as a value
func replace(f) { return 42 }

class Replaced {
    @[replace]
    pub func gone() { }
}

check("a decorator may replace a method with a value", Replaced.gone, 42)

# a native function (tostr is a builtin) is installed as it is, and stays
# usable elsewhere; io.print, by contrast, is an Orbit function and would be
# copied like `helper` above
func to_native(f) { return tostr }

class UsesNative {
    @[to_native]
    pub func say() { }
}

check("a native function installed as it is", UsesNative.say == tostr, true)
check("and still works elsewhere", tostr(5), "5")

# a method of an unrelated class, still waiting for its own self, is refused
class Foreign {
    pub func other() { return 0 }
}

func give_foreign(f) { return Foreign.other }

func build_with_foreign() {
    class Takes {
        @[give_foreign]
        pub func m() { }
    }

    return Takes
}

r_foreign := trap build_with_foreign()
check("a method of an unrelated class is refused", r_foreign.unwrap_err().kind, @TypeError)

# traits: a trait method takes no decorators (05_traits.orb), but a function
# nested in one can be decorated, and so can the method of a class that
# implements the trait
func twice(f) { return func () { return f() * 2 } }

trait Nesting {
    pub func nested() {
        @[twice]
        func inner() { return 21 }

        return inner()
    }
}

class ImplNesting impl Nesting {
    pub var v = 10

    @[plus_one]
    pub func own() { return self.v }
}

impl_nesting := new ImplNesting()
check("a decorated function nested in a trait method", impl_nesting.nested(), 42)
check("a decorated method of a class that implements a trait", impl_nesting.own(), 11)

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
