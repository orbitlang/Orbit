# Numbers suite 07 -- the Number methods on values past INT64_MAX.
#
# bit_length (now up to 64), abs (never overflows: the range is symmetric),
# gcd, is_even/is_odd, max/min/clamp (ordering across SMI and heap values),
# pow (exact up to 2^64-1, OUT_OF_RANGE past it) and sqrt.
#
# EXPECT: contains: ALL TESTS PASSED

import "io"

var fails = 0

func check(name, got, expected) {
    if got == expected {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", got, "expected:", expected)
        fails += 1
    }
}

# `res` is the Result of a `trap`: it must hold an error of kind `want_kind`
func check_error(name, res, want_kind) {
    if res {
        io.print("FAIL ", name, "-- expected an error, got:", res.unwrap())
        fails += 1
        return
    }

    err := res.unwrap_err()

    if err.kind == want_kind {
        io.print("OK   ", name)
    } else {
        io.print("FAIL ", name, "-- got:", err.kind, err.reason, "expected:", want_kind)
        fails += 1
    }
}

MAX := 9223372036854775807      # 2^63 - 1, the largest I64
TOP := 18446744073709551615     # 2^64 - 1, the largest magnitude

# The error for a value out of range (an operation past +-(2^64-1), or a big
# value where a smaller integer is needed). Change it here if the kind changes.
OUT_OF_RANGE := @ValueError

# bit_length, abs
check("bit_length of 2^64-1", tostr(TOP.bit_length()), "64")
check("bit_length of 2^63", tostr((9223372036854775808).bit_length()), "64")
check("bit_length of INT64_MAX", tostr(MAX.bit_length()), "63")
check("bit_length of -(2^64-1)", tostr((-TOP).bit_length()), "64")
check("abs of -(2^64-1)", tostr((-TOP).abs()), "18446744073709551615")
check("abs of -2^63", tostr((-9223372036854775808).abs()), "9223372036854775808")

# gcd, is_even, is_odd
check("gcd(2^64-2, 2^63)", tostr((18446744073709551614).gcd(9223372036854775808)), "2")
check("gcd(2^64-1, 3)", tostr(TOP.gcd(3)), "3")
check("2^64-1 is odd", TOP.is_odd(), true)
check("2^64-1 is not even", TOP.is_even(), false)
check("2^64-2 is even", (18446744073709551614).is_even(), true)
check("2^63 is even", (9223372036854775808).is_even(), true)

# max, min, clamp
check("max(2^64-1, 2^63)", tostr(TOP.max(9223372036854775808)), "18446744073709551615")
check("max(2^63, 2^64-1)", tostr((9223372036854775808).max(TOP)), "18446744073709551615")
check("max(INT64_MAX, 2^63)", tostr(MAX.max(9223372036854775808)), "9223372036854775808")
check("min(-(2^64-1), -2^63)", tostr((-TOP).min(-9223372036854775808)), "-18446744073709551615")
check("clamp(2^64-1, 0, 2^63)", tostr(TOP.clamp(0, 9223372036854775808)), "9223372036854775808")
check("clamp(-(2^64-1), -1, 1)", tostr((-TOP).clamp(-1, 1)), "-1")
check("clamp(5, 0, 2^64-1)", tostr((5).clamp(0, TOP)), "5")

# pow: exact up to 2^64-1, an error past it
check("2.pow(63)", tostr((2).pow(63)), "9223372036854775808")
check("-2.pow(63)", tostr((-2).pow(63)), "-9223372036854775808")
check("3.pow(40)", tostr((3).pow(40)), "12157665459056928801")
check("(2^64-1).pow(1)", tostr(TOP.pow(1)), "18446744073709551615")
check("(2^64-1).pow(0)", tostr(TOP.pow(0)), "1")
check_error("2.pow(64) overflows", trap ((2).pow(64)), OUT_OF_RANGE)
check_error("-2.pow(64) overflows", trap ((-2).pow(64)), OUT_OF_RANGE)
check_error("3.pow(41) overflows", trap ((3).pow(41)), OUT_OF_RANGE)

# sqrt returns a Decimal
check("sqrt(2^64-1) is about 2^32", TOP.sqrt() > 4294967295.99, true)

if fails == 0 {
    io.print("ALL TESTS PASSED")
} else {
    io.print(fails, "TEST(S) FAILED")
}
